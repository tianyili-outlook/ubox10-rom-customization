+static void aic_startapp_trace_timeout_snapshot(struct priv_dev *aicdev)
+{
+	struct aic_startapp_trace *trace = &aicdev->startapp_trace;
+	struct sdio_func *func = READ_ONCE(aicdev->func[0]);
+	struct mmc_host *host;
+	u8 value;
+	int ret;
+
+	if (!func || !func->card || !func->card->host) {
+		WRITE_ONCE(trace->timeout_cccr_intx_ret, -ENODEV);
+		WRITE_ONCE(trace->timeout_cccr_ienx_ret, -ENODEV);
+		return;
+	}
+
+	host = func->card->host;
+	WRITE_ONCE(trace->timeout_func_num, func->num);
+	WRITE_ONCE(trace->timeout_host_cap_sdio_irq,
+		   !!(READ_ONCE(host->caps) & MMC_CAP_SDIO_IRQ));
+	WRITE_ONCE(trace->timeout_host_irq_pending,
+		   !!READ_ONCE(host->sdio_irq_pending));
+	WRITE_ONCE(trace->timeout_irq_claimed, !!sdio_irq_claimed(host));
+	WRITE_ONCE(trace->timeout_handler_installed,
+		   !!READ_ONCE(func->irq_handler));
+
+	/*
+	 * The START_APP wait has already timed out.  Read the read-only CCCR
+	 * pending register first while the function is still present and before
+	 * the existing teardown path; the trace remains active across this
+	 * snapshot so a racing handler is not hidden.
+	 */
+	sdio_claim_host(func);
+	value = sdio_f0_readb(func, SDIO_CCCR_INTx, &ret);
+	WRITE_ONCE(trace->timeout_cccr_intx, value);
+	WRITE_ONCE(trace->timeout_cccr_intx_ret, ret);
+	value = sdio_f0_readb(func, SDIO_CCCR_IENx, &ret);
+	WRITE_ONCE(trace->timeout_cccr_ienx, value);
+	WRITE_ONCE(trace->timeout_cccr_ienx_ret, ret);
+	sdio_release_host(func);
+}

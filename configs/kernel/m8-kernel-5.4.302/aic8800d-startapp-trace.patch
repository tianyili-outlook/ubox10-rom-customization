+static void aic_startapp_trace_begin(struct priv_dev *aicdev,
+				     const struct rwnx_cmd *cmd)
+{
+	struct aic_startapp_trace *trace = &aicdev->startapp_trace;
+	u32 generation = READ_ONCE(trace->generation) + 1;
+
+	atomic_set(&trace->active, 0);
+	WRITE_ONCE(trace->generation, generation);
+	WRITE_ONCE(trace->token, cmd->tkn);
+	WRITE_ONCE(trace->req_id, cmd->id);
+	WRITE_ONCE(trace->cfm_id, cmd->reqid);
+	WRITE_ONCE(trace->tx_queued, 1);
+	WRITE_ONCE(trace->tx_bus_len, 0);
+	WRITE_ONCE(trace->tx_bus_ret, -EINPROGRESS);
+	atomic_set(&trace->tx_cmd53_state, 0);
+	WRITE_ONCE(trace->tx_cmd53_len, 0);
+	WRITE_ONCE(trace->tx_cmd53_ret, -EINPROGRESS);
+	atomic_set(&trace->irq_count, 0);
+	atomic_set(&trace->irq_after_tx_return_count, 0);
+	WRITE_ONCE(trace->irq_block_count, 0);
+	WRITE_ONCE(trace->irq_block_count_ret, -EINPROGRESS);
+	atomic_set(&trace->rx_cmd53_count, 0);
+	atomic_set(&trace->rx_after_tx_return_count, 0);
+	WRITE_ONCE(trace->rx_cmd53_len, 0);
+	WRITE_ONCE(trace->rx_cmd53_ret, -EINPROGRESS);
+	WRITE_ONCE(trace->rx_frame_len, 0);
+	WRITE_ONCE(trace->rx_type, 0);
+	WRITE_ONCE(trace->rx_msg_id, 0);
+	WRITE_ONCE(trace->cfm_seen, 0);
+	WRITE_ONCE(trace->token_match, 0);
+	WRITE_ONCE(trace->completion, 0);
+	smp_wmb();
+	atomic_set(&trace->active, 1);
+}
+
+static void aic_startapp_trace_finish(struct priv_dev *aicdev,
+				      const struct rwnx_cmd *cmd,
+				      const char *result)
+{
+	struct aic_startapp_trace *trace = &aicdev->startapp_trace;
+
+	if (cmd->id != DBG_START_APP_REQ || cmd->reqid != DBG_START_APP_CFM ||
+	    !atomic_xchg(&trace->active, 0))
+		return;
+
+	pr_err("AIC_STARTAPP_TRACE: result=%s gen=%u token=%u req=%u cfm=%u "
+	       "tx_queued=%u tx_bus_len=%u tx_bus_ret=%d "
+	       "tx_cmd53_state=%d tx_cmd53_len=%u tx_cmd53_ret=%d "
+	       "irq_count=%d irq_after_tx_return=%d "
+	       "irq_block_count=%u irq_block_count_ret=%d "
+	       "rx_cmd53_count=%d rx_after_tx_return=%d "
+	       "rx_cmd53_len=%u rx_cmd53_ret=%d "
+	       "rx_frame_len=%u rx_type=0x%02x rx_msg_id=%u "
+	       "cfm_seen=%u token_match=%u completion=%u\n",
+	       result, READ_ONCE(trace->generation), READ_ONCE(trace->token),
+	       READ_ONCE(trace->req_id), READ_ONCE(trace->cfm_id),
+	       READ_ONCE(trace->tx_queued), READ_ONCE(trace->tx_bus_len),
+	       READ_ONCE(trace->tx_bus_ret),
+	       atomic_read(&trace->tx_cmd53_state),
+	       READ_ONCE(trace->tx_cmd53_len), READ_ONCE(trace->tx_cmd53_ret),
+	       atomic_read(&trace->irq_count),
+	       atomic_read(&trace->irq_after_tx_return_count),
+	       READ_ONCE(trace->irq_block_count),
+	       READ_ONCE(trace->irq_block_count_ret),
+	       atomic_read(&trace->rx_cmd53_count),
+	       atomic_read(&trace->rx_after_tx_return_count),
+	       READ_ONCE(trace->rx_cmd53_len), READ_ONCE(trace->rx_cmd53_ret),
+	       READ_ONCE(trace->rx_frame_len), READ_ONCE(trace->rx_type),
+	       READ_ONCE(trace->rx_msg_id),
+	       READ_ONCE(trace->cfm_seen), READ_ONCE(trace->token_match),
+	       READ_ONCE(trace->completion));
+}

  "diagnostic": {
    "prefix": "UBOX_R7_DIAG1",
    "purpose": "Identify the first AVC-versus-HEVC buffer/import contract field or EGL/GL operation that differs before the unchanged RenderEngine fatal.",
    "stages": [
      "CODEC_SELECT",
      "CODEC_OUTPUT",
      "NATIVE_WINDOW",
      "GRALLOC_ALLOC",
      "GRALLOC_HANDLE",
      "AHB_DESC",
      "RENDERENGINE_MAP",
      "NATIVE_CLIENT_BUFFER",
      "EGL_CREATE_IMAGE",
      "GL_GEN_TEXTURE",
      "GL_BIND_TEXTURE",
      "GL_EGL_IMAGE_TARGET",
      "BACKEND_TEXTURE"
    ],
    "correlation": {
      "codec_renderengine_skia": "GraphicBuffer ID / AHardwareBuffer ID",
      "gralloc_allocation_import": "private_handle_t backing_store_id",
      "domain_bridge": "timestamp plus width, height, format, usage, allocation metadata",
      "limitation": "The public GraphicBuffer/AHardwareBuffer ID is not the donor private-handle backing_store_id; no new ioctl, syscall, or cross-process registry is added."
    },
    "error_state_semantics": "The failed eglCreateImageKHR path still calls eglGetError exactly once and reuses that value. Existing post-bind and post-image-target glGetError calls remain exactly one each. No EGL/GL error query is added on successful or previously unchecked operations.",
    "filter": "AVC/HEVC configuration and large video state; YV12 buffers at least 1280x720; allocation/import events rather than per-frame rendering",
    "hwc_instrumented": false,
    "hwc_reason": "Optional corroboration was omitted to minimize delta; eager RenderEngine import is the proven causal boundary."
  },

diff --git a/src/gpu/ganesh/gl/UBOXR7Compat1Metadata.h b/src/gpu/ganesh/gl/UBOXR7Compat1Metadata.h
--- a/src/gpu/ganesh/gl/UBOXR7Compat1Metadata.h
+++ b/src/gpu/ganesh/gl/UBOXR7Compat1Metadata.h
@@ -4,3 +4,8 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/memfd.h>
 #include <stddef.h>
 #include <stdint.h>
 #include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
@@ -38,0 +44,20 @@
+
+inline int createSizedShadowFd(const char* name, size_t size) {
+    int fd = static_cast<int>(syscall(__NR_memfd_create, name,
+                                      MFD_CLOEXEC | MFD_ALLOW_SEALING));
+    if (fd < 0) {
+        return -1;
+    }
+
+    int result;
+    do {
+        result = ftruncate(fd, static_cast<off_t>(size));
+    } while (result < 0 && errno == EINTR);
+    if (result < 0 || fcntl(fd, F_ADD_SEALS, F_SEAL_GROW | F_SEAL_SHRINK) < 0) {
+        const int savedErrno = errno;
+        close(fd);
+        errno = savedErrno;
+        return -1;
+    }
+    return fd;
+}

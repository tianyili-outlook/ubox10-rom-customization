+	const uint8_t *bytes = static_cast<const uint8_t *>(base);
+	uint64_t hash = UINT64_C(14695981039346656037);
+	for (size_t i = 0; i < size; ++i)
+	{
+		hash ^= bytes[i];
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}

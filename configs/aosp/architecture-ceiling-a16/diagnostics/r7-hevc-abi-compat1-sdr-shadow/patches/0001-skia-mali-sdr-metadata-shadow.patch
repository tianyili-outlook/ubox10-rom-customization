new file mode 100644
index 0000000..6d054bf
--- /dev/null
+++ b/src/gpu/ganesh/gl/UBOXR7Compat1Metadata.h
@@ -0,0 +1,54 @@
+/* EXPERIMENTAL SDR YV12 MALI METADATA ABI COMPATIBILITY / NOT r8. */
+#ifndef UBOX_R7_COMPAT1_METADATA_H_
+#define UBOX_R7_COMPAT1_METADATA_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace ubox_r7_compat1 {
+
+constexpr size_t kMetadataSize = 0x6000;
+constexpr size_t kLegacyAttrOffset = 0x80;
+constexpr size_t kActiveAttrOffset = 23544;
+constexpr size_t kAttrSize = 56;
+constexpr size_t kSunxiFlagOffset = 23476;
+
+struct LegacyAttrRegion {
+    int32_t cropTop;
+    int32_t cropLeft;
+    int32_t cropHeight;
+    int32_t cropWidth;
+    int32_t useYuvTransform;
+    int32_t useSparseAlloc;
+    uint8_t hdrInfo[28];
+    int32_t dataspace;
+};
+
+static_assert(sizeof(LegacyAttrRegion) == kAttrSize);
+static_assert(offsetof(LegacyAttrRegion, cropTop) == 0);
+static_assert(offsetof(LegacyAttrRegion, cropLeft) == 4);
+static_assert(offsetof(LegacyAttrRegion, cropHeight) == 8);
+static_assert(offsetof(LegacyAttrRegion, cropWidth) == 12);
+static_assert(offsetof(LegacyAttrRegion, useYuvTransform) == 16);
+static_assert(offsetof(LegacyAttrRegion, useSparseAlloc) == 20);
+static_assert(offsetof(LegacyAttrRegion, hdrInfo) == 24);
+static_assert(offsetof(LegacyAttrRegion, dataspace) == 52);
+static_assert(kLegacyAttrOffset + kAttrSize == 0xb8);
+static_assert(kActiveAttrOffset + kAttrSize == 23600);
+
+inline bool translateMetadata(const void* original, size_t originalSize, void* shadow,
+                              size_t shadowSize) {
+    if (original == nullptr || shadow == nullptr || originalSize != kMetadataSize ||
+        shadowSize != kMetadataSize || original == shadow) {
+        return false;
+    }
+    memcpy(shadow, original, kMetadataSize);
+    memcpy(static_cast<uint8_t*>(shadow) + kLegacyAttrOffset,
+           static_cast<const uint8_t*>(original) + kActiveAttrOffset, kAttrSize);
+    return true;
+}
+
+}  // namespace ubox_r7_compat1
+
+#endif
